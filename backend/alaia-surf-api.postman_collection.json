{
  "info": {
    "name": "ALAIA Surf API",
    "description": "Backend REST API (Express 5). Auth = HttpOnly cookie auth_token set by POST /api/auth/login. Postman stores it in the cookie jar and resends it automatically on protected routes. Run Login first, then admin routes work. baseUrl variable = http://localhost:3000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "mediaId", "value": "1", "type": "string" },
    { "key": "sessionId", "value": "1", "type": "string" },
    { "key": "userId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"YourPassword1\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Sets the HttpOnly auth_token cookie. Run this first."
          }
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] },
            "description": "Returns the current logged-in user. Requires auth cookie."
          }
        },
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        },
        {
          "name": "POST /api/auth/reset-password-request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/reset-password-request", "host": ["{{baseUrl}}"], "path": ["api", "auth", "reset-password-request"] }
          }
        },
        {
          "name": "POST /api/auth/reset-password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"reset-token-uuid\",\n  \"password\": \"NewPass123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "reset-password"] },
            "description": "Password must be 8+ chars, 1 uppercase, 1 number."
          }
        },
        {
          "name": "GET /api/auth/users (SUPER_ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/users", "host": ["{{baseUrl}}"], "path": ["api", "auth", "users"] }
          }
        },
        {
          "name": "POST /api/auth/users/invite (SUPER_ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"coach@example.com\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Coach\",\n  \"role\": \"COACH\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/users/invite", "host": ["{{baseUrl}}"], "path": ["api", "auth", "users", "invite"] },
            "description": "role: SUPER_ADMIN | COACH. Sends a set-password email to the new user."
          }
        },
        {
          "name": "DELETE /api/auth/users/:id (SUPER_ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "auth", "users", "{{userId}}"] }
          }
        }
      ]
    },
    {
      "name": "Contact",
      "item": [
        {
          "name": "POST /api/contact (public)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"+64 21 123 4567\",\n  \"subject\": \"Question about lessons\",\n  \"message\": \"Hi, do you offer beginner lessons?\",\n  \"source\": \"Contact\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/contact", "host": ["{{baseUrl}}"], "path": ["api", "contact"] },
            "description": "Email-only, no DB record. phone and source are optional. source prefixes the email subject (e.g. 'Surf Trip Request', 'Booking', 'Contact')."
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "GET /api/sessions/public",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/sessions/public", "host": ["{{baseUrl}}"], "path": ["api", "sessions", "public"] },
            "description": "Returns upcoming sessions. Public, no auth required."
          }
        },
        {
          "name": "GET /api/sessions (SUPER_ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/sessions", "host": ["{{baseUrl}}"], "path": ["api", "sessions"] }
          }
        },
        {
          "name": "POST /api/sessions (SUPER_ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-07-01\",\n  \"time\": \"09:00\",\n  \"type\": \"Group - Adults\",\n  \"duration\": \"2h\",\n  \"price\": 60\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/sessions", "host": ["{{baseUrl}}"], "path": ["api", "sessions"] },
            "description": "type: 'Group - Adults' | 'Group - Kids'. date format: YYYY-MM-DD."
          }
        },
        {
          "name": "DELETE /api/sessions/:id (SUPER_ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionId}}", "host": ["{{baseUrl}}"], "path": ["api", "sessions", "{{sessionId}}"] }
          }
        }
      ]
    },
    {
      "name": "Site Content",
      "item": [
        {
          "name": "GET /api/content (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/content", "host": ["{{baseUrl}}"], "path": ["api", "content"] }
          }
        },
        {
          "name": "GET /api/content/page/:pageName (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/content/page/home", "host": ["{{baseUrl}}"], "path": ["api", "content", "page", "home"] },
            "description": "pageName: home | about | surf-in-new-zealand | book-surf-lesson | surf-trip | faq | terms | privacy | global"
          }
        },
        {
          "name": "GET /api/content/key/:keyName (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/content/key/home_hero_title", "host": ["{{baseUrl}}"], "path": ["api", "content", "key", "home_hero_title"] }
          }
        },
        {
          "name": "PUT /api/content/key/:keyName (SUPER_ADMIN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": \"Your next adventure starts here\",\n  \"page\": \"home\",\n  \"label\": \"Hero Title\",\n  \"type\": \"TEXT\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/content/key/home_hero_title", "host": ["{{baseUrl}}"], "path": ["api", "content", "key", "home_hero_title"] },
            "description": "type: TEXT | RICHTEXT | IMAGE_URL | NUMBER."
          }
        }
      ]
    },
    {
      "name": "Media",
      "item": [
        {
          "name": "GET /api/media (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/media", "host": ["{{baseUrl}}"], "path": ["api", "media"] }
          }
        },
        {
          "name": "GET /api/media/:id (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/media/{{mediaId}}", "host": ["{{baseUrl}}"], "path": ["api", "media", "{{mediaId}}"] }
          }
        },
        {
          "name": "POST /api/media (upload, SUPER_ADMIN)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "files", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/media", "host": ["{{baseUrl}}"], "path": ["api", "media"] },
            "description": "Multipart upload to Cloudinary. Field name 'files'. Pick file(s) in the Body tab."
          }
        },
        {
          "name": "PUT /api/media/:id (SUPER_ADMIN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"alt\": \"Surfer paddling out at dawn\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/media/{{mediaId}}", "host": ["{{baseUrl}}"], "path": ["api", "media", "{{mediaId}}"] }
          }
        },
        {
          "name": "DELETE /api/media/:id (SUPER_ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/media/{{mediaId}}", "host": ["{{baseUrl}}"], "path": ["api", "media", "{{mediaId}}"] }
          }
        }
      ]
    }
  ]
}
